# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=DevEduHub
APP_ENV=local
APP_KEY=                          # Generate: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_PORT_EXTERNAL=5432
DB_DATABASE=deveduhub
DB_USERNAME=postgres
DB_PASSWORD=secret

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PORT_EXTERNAL=6379
QUEUE_CONNECTION=redis

# ── Grader ────────────────────────────────────────────────────────────────────
GRADER_URL=http://grader:8000
GRADER_PORT=8000
GRADER_TIMEOUT=150
GRADER_CONNECT_TIMEOUT=10

# ── CORS (grader) — set to nginx service name in Docker, or full URL in prod ──
LARAVEL_ORIGIN=http://nginx

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@deveduhub.com
MAIL_FROM_NAME=DevEduHub

# ── Sanctum ───────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:8080,localhost:3000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Logtail (Better Stack) — set in staging + production ──────────────────────
# Get your token from: https://logs.betterstack.com
LOGTAIL_TOKEN=

# ── GitHub Actions deploy secrets (set in GitHub repo settings) ───────────────
# STAGING_HOST=
# STAGING_USER=
# STAGING_SSH_KEY=
# PROD_HOST=
# PROD_USER=
# PROD_SSH_KEY=
# MAINTENANCE_SECRET=
