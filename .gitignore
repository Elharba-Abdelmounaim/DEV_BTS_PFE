# ── DevEduHub Root Gitignore ─────────────────────────────────────────────────

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
.docker/
# Do NOT ignore the data volumes if you want them to persist locally, 
# but they shouldn't be in Git anyway.

# Local environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Dependencies
node_modules/
vendor/

# Build outputs
dist/
build/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Project specific
backend/.env
backend/vendor/
backend/node_modules/
frontend/node_modules/
frontend/dist/
grader/__pycache__/
grader/venv/
